<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="resource_resource_form_caldav" model="ir.ui.view">
        <field name="name">resource.resource.form.caldav</field>
        <field name="model">resource.resource</field>
        <field name="inherit_id" ref="resource.resource_resource_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='resource_details']" position="inside">
                <field
                    name="caldav_enabled"
                    groups="base.group_system"
                    invisible="resource_type != 'user'"
                />
            </xpath>
        </field>
    </record>
</odoo>
