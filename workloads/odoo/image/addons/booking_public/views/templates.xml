<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="index" name="Booking: services">
        <t t-call="website.layout">
            <div id="wrap" class="o_booking_public">
                <div class="container py-5">
                    <h1 class="mb-4">Book a session</h1>
                    <t t-if="types">
                        <div class="row">
                            <t t-foreach="types" t-as="btype">
                                <div class="col-md-6 col-lg-4 mb-4">
                                    <div class="card h-100">
                                        <div class="card-body d-flex flex-column">
                                            <h2 class="h4">
                                                <t t-esc="btype.name" />
                                            </h2>
                                            <p class="mb-2">
                                                <span class="badge text-bg-light">
                                                    <t t-esc="'%g' % btype.duration" /> h
                                                </span>
                                                <span t-if="btype.product_id and btype.product_id.list_price" class="ms-2">
                                                    <t t-esc="btype.currency_id.symbol" /><t t-esc="'%.2f' % btype.product_id.list_price" />
                                                </span>
                                            </p>
                                            <p t-if="btype.deposit_mode != 'none'" class="text-muted small">
                                                Deposit on booking:
                                                <t t-esc="btype.currency_id.symbol" /><t t-esc="'%.2f' % btype.deposit_amount" />
                                            </p>
                                            <a class="btn btn-primary mt-auto" t-attf-href="/book/#{btype.id}">Choose a time</a>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </t>
                    <p t-else="" class="lead">No sessions are open for booking yet. Please get in touch.</p>
                </div>
            </div>
        </t>
    </template>

    <template id="type_page" name="Booking: pick a time">
        <t t-call="website.layout">
            <div id="wrap" class="o_booking_public">
                <div class="container py-5">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/book">All sessions</a></li>
                        <li class="breadcrumb-item active"><t t-esc="btype.name" /></li>
                    </ol>
                    <h1><t t-esc="btype.name" /></h1>
                    <div t-if="btype.public_intro" class="mb-4"><t t-out="btype.public_intro" /></div>
                    <p class="text-muted">
                        <t t-esc="'%g' % btype.duration" /> h · times shown in <t t-esc="btype.resource_calendar_id.tz or 'UTC'" />
                        <span t-if="btype.deposit_mode != 'none'">
                            · deposit <t t-esc="btype.currency_id.symbol" /><t t-esc="'%.2f' % btype.deposit_amount" />
                            when you book
                        </span>
                    </p>
                    <div t-if="error" class="alert alert-warning" role="alert"><t t-esc="error" /></div>
                    <form method="post" t-attf-action="/book/#{btype.id}/confirm" class="row g-3" id="booking_form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                        <input type="hidden" name="booking_key" t-att-value="booking_key" />
                        <div class="col-md-4">
                            <label class="form-label" for="booking_name">Your name</label>
                            <input type="text" class="form-control" id="booking_name" name="name" required="required" t-att-value="values.get('name', '')" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="booking_email">Email</label>
                            <input type="email" class="form-control" id="booking_email" name="email" required="required" t-att-value="values.get('email', '')" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="booking_phone">Phone (optional)</label>
                            <input type="tel" class="form-control" id="booking_phone" name="phone" t-att-value="values.get('phone', '')" />
                        </div>
                        <div class="col-12">
                            <p id="booking_waiting" class="alert alert-info mt-3 d-none" role="status">
                                Booking your time. This takes a few seconds.
                            </p>
                            <t t-if="days">
                                <t t-foreach="days" t-as="day">
                                    <h2 class="h6 mt-4"><t t-esc="day['label']" /></h2>
                                    <div class="d-flex flex-wrap gap-2">
                                        <t t-foreach="day['slots']" t-as="slot">
                                            <button type="submit" class="btn btn-outline-primary" name="when" t-att-value="slot['value']"><t t-esc="slot['label']" /></button>
                                        </t>
                                    </div>
                                </t>
                            </t>
                            <p t-else="" class="alert alert-info mt-3"><t t-esc="no_slot_text" /></p>
                        </div>
                    </form>
                    <script>
                        (function () {
                            var form = document.getElementById("booking_form");
                            if (!form) return;
                            var waiting = document.getElementById("booking_waiting");
                            var timer = null;
                            function setSending(on) {
                                form.dataset.sending = on ? "1" : "";
                                form.style.pointerEvents = on ? "none" : "";
                                form.style.opacity = on ? "0.6" : "";
                                if (waiting) waiting.classList.toggle("d-none", !on);
                                if (!on) {
                                    clearTimeout(timer);
                                    timer = null;
                                }
                            }
                            form.addEventListener("submit", function (ev) {
                                // A slot clicked again while the first request is in
                                // flight would be a second booking, not a faster one.
                                if (form.dataset.sending === "1") {
                                    ev.preventDefault();
                                    return;
                                }
                                setSending(true);
                                // A dropped connection must not leave the page dead.
                                timer = setTimeout(function () { setSending(false); }, 60000);
                            });
                            // Back button, or a page restored from the cache.
                            window.addEventListener("pageshow", function () { setSending(false); });
                        })();
                    </script>
                </div>
            </div>
        </t>
    </template>

    <!-- OCA renders "Meeting URL:" on every booking, empty href included; show a
         real button only when the booking has a link. -->
    <template id="portal_meeting_url" inherit_id="resource_booking.resource_booking_portal_form">
        <xpath expr="//strong[normalize-space(.)='Meeting URL:']/parent::div" position="replace">
            <div t-if="booking_sudo.videocall_location" class="mb-1">
                <a
                    class="btn btn-primary btn-sm"
                    t-att-href="booking_sudo.videocall_location"
                    target="_blank"
                    rel="noopener"
                >Join the video call</a>
            </div>
        </xpath>
    </template>
</odoo>
