  of_indoorcam [label="Indoorcam\n192.168.5.59", fillcolor="#eceff1", width=1.3];
  u7proxgs -> of_indoorcam [style=dotted, color=gray, weight=0];
  of_vpin [label="vpin\n192.168.5.118", fillcolor="#eceff1", width=1.3];
  u7proxgs -> of_vpin [style=dotted, color=gray, weight=0];
  of_bedroom [label="Bedroom\n192.168.5.85", fillcolor="#eceff1", width=1.3];
  u7proxgs -> of_bedroom [style=dotted, color=gray, weight=0];
  of_leighanesiphone [label="LeighanesiPhone\n192.168.5.112", fillcolor="#eceff1", width=1.3];
  u7proxgs -> of_leighanesiphone [style=dotted, color=gray, weight=0];
  of_presence [label="presence\n192.168.5.170", fillcolor="#eceff1", width=1.3];
  u7proxgs -> of_presence [style=dotted, color=gray, weight=0];
  of_aidot [label="AiDot\n192.168.5.168", fillcolor="#eceff1", width=1.3];
  u7proxgs -> of_aidot [style=dotted, color=gray, weight=0];
  }

  // ---- VIPs ----
  vipc [label="MetalLB — Cluster (13)\n.6.14 coturn   .6.17 openrct2   .6.19 mosquitto\n.6.20 temporal   .6.21 coturn   .6.22 livekit\n.6.23 mimir   .6.24 loki   .6.25 syslog\n.6.26 frigate   .6.30 lan-dns   .6.31 seaweedfs\n.5.10 kubernetes-api :6443", fillcolor="#f7e3c7", fontsize=9];
