digraph home {
  rankdir=LR; splines=polyline; nodesep=0.35; ranksep=0.75; bgcolor="transparent"; fontname="Helvetica";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, fillcolor="white"];
  edge [fontname="Helvetica", fontsize=8];
  internet [class="internet", shape=ellipse, label="Internet", peripheries=2, fontsize=11];
  verizon [class="net", label="Verizon CR1000B\n192.168.0.1\nper-port forwards"];
  homepi [class="srv", label="home-pi\nAttic :8280\n192.168.0.154"];
  router [class="net", penwidth=2, fontsize=11, label="ROUTER RB5009UPr+S+\n.0.2 WAN · .5.1 · .1.1 · .88.254\nBGP 65001 · BFD 3784 · WireGuard 51820\ndst-nat 15 rules · DNS FWD ×6"];
  internet -> verizon [label=" coax"];
  verizon -> router [label=" 2.5G 2GWAN"];
  verizon -> homepi [label=" 1GbE"];

  // ---- switch chain (LLDP-confirmed both ways) ----
  core [class="net", penwidth=2, fontsize=11, label="CORE  CRS305-1G-4S+\n192.168.5.4 (+ .1.250)\n4×SFP+ 10G"];
  ucore [class="net", penwidth=2, fontsize=11, label="UPSTAIRS-CORE  CRS305-1G-4S+\n192.168.5.5 (+ .88.1)\n4×SFP+ 10G"];
  upstairs [class="net", penwidth=2, fontsize=11, label="UPSTAIRS  CRS310-8G+2S+\n192.168.5.3\n8×1G + 2×SFP+"];
  office [class="net", penwidth=2, fontsize=11, label="OFFICE  CRS310-8G+2S+\n192.168.5.2\n8×1G + 2×SFP+"];
  router -> core [label=" 10GsfpLAN ↔ sfp-sfpplus4  10G"];
  router -> core [label=" core-poe ↔ ether1  1G PoE + mgmt", style=dashed, weight=0];
  core -> ucore [label=" sfp-sfpplus2 ↔ sfp-sfpplus2  10G"];
  core -> office [label=" sfp-sfpplus3 ↔ sfp-sfpplus2  10G"];
  ucore -> upstairs [label=" sfp-sfpplus4 ↔ sfp-sfpplus1  10G"];

  // ---- directly attached to the router ----
  u7lite [class="ap", label="U7 Lite AP\n192.168.5.173\nrouter u7-lite (ether5) · PoE"];
  pite [class="kube", label="pite · k3s agent\n192.168.5.9\nrouter pite (ether8)"];
  cam_driveway [class="cam", label="Front Driveway cam\n192.168.1.66\nrouter cam-front (ether7)"];
  jetkvm [class="cli", label="JetKVM\n192.168.5.187\nrouter jetkvm (ether4)"];
  router -> u7lite [label=" u7-lite (ether5) 1G PoE"];
  router -> pite [label=" pite (ether8) 1G"];
  router -> cam_driveway [label=" cam-front (ether7) 1G"];
  router -> jetkvm [label=" jetkvm (ether4) 100M"];

  // ---- servers on switch ports (MAC-table confirmed) ----
  nas [class="kube", label="nas · k3s server/etcd\n192.168.5.175\nZFS · Attic"];
  closet [class="kube", label="closet · k3s server/etcd\n192.168.5.36\npostgres · kubectl host"];
  arch [class="kube", label="arch · k3s server/etcd\n192.168.5.76\nmonero 18080"];
  glkvm [class="srv", label="GL-KVM\n192.168.5.8"];
  bigp [class="srv", label="bigp · Proxmox PVE 9.2.2\n192.168.5.19"];
  big [class="kube", label="big · k3s agent (VM)\n192.168.5.68"];
  brother [class="cli", label="Brother printer\n192.168.5.6"];
  nvr [class="cam", label="Reolink NVR (PoE)\n192.168.1.67"];
  u7proxgs [class="ap", label="U7 Pro XGS AP\n192.168.5.171\noffice sfp-sfpplus1 10G"];
  u7mesh [class="ap", label="U7 Mesh AP\n192.168.5.198"];
  vpin [class="srv", label="vpin · Mullvad exit (Pi)\n192.168.5.118"];
  bedroom [class="cli", label="Bedroom lightswitch\n192.168.5.85"];
  core -> nas [label=" sfp-sfpplus1 10G"];
  ucore -> closet [label=" sfp-sfpplus1 10G"];
  ucore -> arch [label=" sfp-sfpplus3 10G"];
  ucore -> glkvm [label=" ether1 1G"];
  upstairs -> bigp [label=" sfp-sfpplus2 10G (+ ether2 LOM, ether5 iDRAC)"];
  bigp -> big [label=" VM (bridged)"];
  upstairs -> brother [label=" ether6 100M"];
  upstairs -> nvr [label=" ether1 1G"];
  upstairs -> bedroom [label=" ether4 1G"];
  upstairs -> vpin [label=" ether8 100M"];
  office -> u7proxgs [label=" sfp-sfpplus1 10G"];
  u7lite -> u7mesh [class="wifi", label=" mesh, pinned ~-61 dBm", style=dotted];

  cam_gate [class="cam", label="Front Gate cam\n192.168.1.64"];
  cam_porch [class="cam", label="Front Porch cam\n192.168.1.63"];
  nvr -> cam_gate [label=" PoE"];
  nvr -> cam_porch [label=" PoE"];

  subgraph cluster_wl { label="WiFi via U7 Lite / Mesh (confirmed by router port ether5)"; style=dashed; fontsize=9; color="gray";
  wl_secu [class="cli", label="secu\n192.168.5.140", width=1.3];
  u7lite -> wl_secu [class="wifi", style=dotted, weight=0];
  wl_garage_cam [class="cam", label="Garage cam\n192.168.1.61", width=1.3];
  u7lite -> wl_garage_cam [class="wifi", style=dotted, weight=0];
  wl_side_cam [class="cam", label="Side cam\n192.168.1.65", width=1.3];
  u7lite -> wl_side_cam [class="wifi", style=dotted, weight=0];
  wl_eight_pod [class="cli", label="eight-pod\n192.168.5.246", width=1.3];
  u7lite -> wl_eight_pod [class="wifi", style=dotted, weight=0];
  wl_livingroom [class="cli", label="livingroom\n192.168.5.121", width=1.3];
  u7lite -> wl_livingroom [class="wifi", style=dotted, weight=0];
  wl_iphone [class="cli", label="iPhone\n192.168.5.124", width=1.3];
  u7lite -> wl_iphone [class="wifi", style=dotted, weight=0];
  wl_ups [class="cli", label="UPS\n192.168.5.127", width=1.3];
  u7lite -> wl_ups [class="wifi", style=dotted, weight=0];
  wl_aidot [class="cli", label="AiDot\n192.168.5.164", width=1.3];
  u7lite -> wl_aidot [class="wifi", style=dotted, weight=0];
  wl_wiz [class="cli", label="WiZ\n192.168.5.132", width=1.3];
  u7lite -> wl_wiz [class="wifi", style=dotted, weight=0];
  wl_mirror [class="cli", label="mirror\n192.168.5.123", width=1.3];
  u7lite -> wl_mirror [class="wifi", style=dotted, weight=0];
  wl_presence [class="cli", label="presence\n192.168.5.165", width=1.3];
  u7lite -> wl_presence [class="wifi", style=dotted, weight=0];
  wl_unknown [class="cli", label="unknown\n192.168.5.146", width=1.3];
  u7lite -> wl_unknown [class="wifi", style=dotted, weight=0];
  }

  subgraph cluster_off { label="WiFi via U7 Pro XGS (inferred: shares the 10G uplink with wired hosts)"; style=dashed; fontsize=9; color="gray";
  of_office_k3s_agent [class="kube", label="office k3s agent\n192.168.5.209", width=1.3];
  u7proxgs -> of_office_k3s_agent [class="wifi", style=dotted, weight=0];
  of_eufy_doorbell [class="cli", label="eufy doorbell\n192.168.5.152", width=1.3];
  u7proxgs -> of_eufy_doorbell [class="wifi", style=dotted, weight=0];
  of_indoorcam [class="cli", label="Indoorcam\n192.168.5.59", width=1.3];
  u7proxgs -> of_indoorcam [class="wifi", style=dotted, weight=0];
  of_leighanesiphone [class="cli", label="LeighanesiPhone\n192.168.5.112", width=1.3];
  u7proxgs -> of_leighanesiphone [class="wifi", style=dotted, weight=0];
  of_presence [class="cli", label="presence\n192.168.5.170", width=1.3];
  u7proxgs -> of_presence [class="wifi", style=dotted, weight=0];
  of_aidot [class="cli", label="AiDot\n192.168.5.168", width=1.3];
  u7proxgs -> of_aidot [class="wifi", style=dotted, weight=0];
  }

  vipc [class="vip", fontsize=9, label="MetalLB — Cluster (13)\n.6.14 coturn   .6.17 openrct2   .6.19 mosquitto\n.6.20 temporal   .6.21 coturn   .6.22 livekit\n.6.23 mimir   .6.24 loki   .6.25 syslog\n.6.26 frigate   .6.30 lan-dns   .6.31 seaweedfs\n.5.10 kubernetes-api :6443"];
  vipl [class="vip", fontsize=9, label="MetalLB — Local (7)\n.6.6 traefik   .6.13 stalwart\n.6.15 ts-voice   .6.16 ts-files\n.6.18 stun   .6.28 factorio   .6.29 minecraft"];
  router -> vipc [class="vip", style=dashed, label=" BGP 65001 (all speakers)"];
  router -> vipl [class="vip", style=dashed, label=" BGP 65001 (one node each)"];
}
