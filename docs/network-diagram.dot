  wl_eight_pod [label="eight-pod\n192.168.5.246", fillcolor="#eceff1", width=1.3];
  u7lite -> wl_eight_pod [style=dotted, color=gray, weight=0];
  wl_livingroom [label="livingroom\n192.168.5.121", fillcolor="#eceff1", width=1.3];
  u7lite -> wl_livingroom [style=dotted, color=gray, weight=0];
  wl_iphone [label="iPhone\n192.168.5.124", fillcolor="#eceff1", width=1.3];
  u7lite -> wl_iphone [style=dotted, color=gray, weight=0];
  wl_ups [label="UPS\n192.168.5.127", fillcolor="#eceff1", width=1.3];
  u7lite -> wl_ups [style=dotted, color=gray, weight=0];
  wl_aidot [label="AiDot\n192.168.5.164", fillcolor="#eceff1", width=1.3];
  u7lite -> wl_aidot [style=dotted, color=gray, weight=0];
  wl_wiz [label="WiZ\n192.168.5.132", fillcolor="#eceff1", width=1.3];
  u7lite -> wl_wiz [style=dotted, color=gray, weight=0];
  wl_mirror [label="mirror\n192.168.5.123", fillcolor="#eceff1", width=1.3];
  u7lite -> wl_mirror [style=dotted, color=gray, weight=0];
  wl_presence [label="presence\n192.168.5.165", fillcolor="#eceff1", width=1.3];
  u7lite -> wl_presence [style=dotted, color=gray, weight=0];
  wl_unknown [label="unknown\n192.168.5.146", fillcolor="#eceff1", width=1.3];
  u7lite -> wl_unknown [style=dotted, color=gray, weight=0];
  }

  // ---- office AP clients (association not separable without the controller) ----
  subgraph cluster_off { label="WiFi via U7 Pro XGS (inferred: shares the 10G uplink with wired hosts)"; style=dashed; color=gray; fontsize=9;
  of_office_k3s_agent [label="office k3s agent\n192.168.5.209", fillcolor="#d9f0e4", width=1.3];
  u7proxgs -> of_office_k3s_agent [style=dotted, color=gray, weight=0];
